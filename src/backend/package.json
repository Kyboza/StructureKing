{
    "name": "backend-slutprojekt",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon --watch . --ext ts,js --exec \"ts-node server.ts\"",
        "build": "cross-env NODE_ENV=production tsc -b tsconfig.json",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "postinstall": "npm run build"
    },
    "dependencies": {
        "@sentry/node": "^10.40.0",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.36.2",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.1.0",
        "mongoose": "^9.2.2",
        "socket.io": "^4.8.3",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.11.0",
        "cross-env": "^10.1.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
